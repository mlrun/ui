    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "acorn": "^8.18.0",
    "autoprefixer": "^10.5.4",
    "body-parser": "^2.3.0",
    "chai": "^6.2.2",
    "chromedriver": "^151.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
