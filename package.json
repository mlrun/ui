      "undici": "^7.30.1"
    }
  },
  "scripts": {
    "start": "vite",
    "postinstall": "node scripts/patchPackages.mjs",
    "build": "vite build",
    "preview:federation": "cross-env PREVIEW_MODE=true dotenv -e .env.development.mf -- vite build && node scripts/previewLocalBuildMF.mjs",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \".storybook/**/*.{js,mjs}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \".storybook/**/*.{js,mjs}\" --fix",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:write": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "preview": "vite preview",
    "test:coverage": "npm run test -- --coverage --watchAll=false",
    "docker": "docker buildx build --platform linux/amd64 -t ${MLRUN_DOCKER_REGISTRY}${MLRUN_DOCKER_REPO:-mlrun}/mlrun-ui:${MLRUN_DOCKER_TAG:-latest} --build-arg COMMIT_HASH=\"`git rev-parse --short HEAD`\" --build-arg GIT_COMMIT_SHA=\"`git rev-parse HEAD`\" --build-arg DATE=\"`date -u`\" -f Dockerfile .",
    "generate-rn": "./generate-release-notes.js ${MLRUN_OLD_VERSION} ${MLRUN_VERSION} ${MLRUN_RELEASE_BRANCH} ${MLRUN_RELEASE_TYPE}",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "mock-server": "node scripts/mockServer.js",
    "mock-server:dev": "node --watch-path=tests/mockServer scripts/mockServer.js",
    "test": "vitest",
    "test:ui": "node scripts/testui.js",
    "test:watch": "vitest --watch",
    "report": "allure generate tests/reports/allure-results",
    "report:open": "allure open tests/reports/allure-report",
    "report:watch": "allure watch --no-new-only --open tests/reports/allure-results",
    "test:regression": "npm run test:ui && npm run report",
    "start:regression": "concurrently \"npm:mock-server\" \"npm:start\" \"npm:test:regression\"",
    "build:regression": "vite build --mode development --base / --outDir build/regression",
    "preview:regression": "vite preview --mode development --outDir build/regression --port 3000 --strictPort",
    "start:regression:fast": "npm run build:regression && concurrently \"npm:mock-server\" \"npm:preview:regression\" \"npm:test:regression\"",
    "ui-steps": "node scripts/collectUITestsSteps.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/builder-vite": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.19.0",
    "allure": "^3.20.1",
    "allure-cucumberjs": "^3.13.0",
    "body-parser": "^2.3.0",
    "chai": "^6.3.0",
    "chromedriver": "^155.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fs-extra": "^11.4.1",
    "geckodriver": "^6.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "mime-types": "^3.0.2",
    "prettier": "^3.9.10",
    "randexp": "^0.5.3",
    "sass": "^1.105.1",
    "selenium-webdriver": "^4.51.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.12"
  }
}
