    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.7",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "geckodriver": "^6.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "mime-types": "^3.0.2",
    "node": "24.18.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "randexp": "^0.5.3",
    "sass": "^1.102.0",
